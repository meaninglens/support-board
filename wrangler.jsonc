// 화면은 site/ 정적 파일, /api/*와 /data/items.json만 worker.js가 처리한다 (Cloudflare 무료 한도 안)
{
  "name": "meaning-support-board",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/data/items.json"] },
  "workers_dev": true
}
